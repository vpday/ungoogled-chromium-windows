+namespace {
+
+bool IsGenericFontFamily(const std::string& lower) {
+  return lower == "serif" || lower == "sans-serif" || lower == "monospace" ||
+         lower == "cursive" || lower == "fantasy" || lower == "system-ui" ||
+         lower == "-webkit-body" || lower == "-webkit-standard" ||
+         lower == "ui-serif" || lower == "ui-sans-serif" ||
+         lower == "ui-monospace" || lower == "ui-rounded" ||
+         lower == "math" || lower == "emoji" || lower == "fangsong";
+}
+
+bool IsFontFamilyBlocked(const AtomicString& family) {
+  ALLOW_DISCOURAGED_TYPE("process-wide font blacklist")
+  static const auto* blocked_fonts = []() -> std::set<std::string>* {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    std::string list;
+    if (cmd->HasSwitch("font-blacklist")) {
+      list = cmd->GetSwitchValueASCII("font-blacklist");
+    }
+    if (cmd->HasSwitch("fonts-hidden")) {
+      const std::string extra = cmd->GetSwitchValueASCII("fonts-hidden");
+      if (!extra.empty()) {
+        if (!list.empty()) {
+          list.push_back(',');
+        }
+        list.append(extra);
+      }
+    }
+    if (list.empty()) {
+      return nullptr;
+    }
+    auto* s = new std::set<std::string>();
+    std::vector<std::string> items = base::SplitString(
+        list, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    for (std::string item : items) {
+      base::TrimString(item, "\"'", &item);
+      if (!item.empty()) {
+        s->insert(base::ToLowerASCII(item));
+      }
+    }
+    return s;
+  }();
+
+  if (!blocked_fonts || blocked_fonts->empty()) {
+    return false;
+  }
+  const std::string lower = base::ToLowerASCII(family.Utf8());
+  if (IsGenericFontFamily(lower)) {
+    return false;
+  }
+  return blocked_fonts->find(lower) != blocked_fonts->end();
+}
