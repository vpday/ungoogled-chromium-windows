+def GetResourceIdFromMangledName(name):
+  match = re.search(
+      r'\?\?\$AllowlistedResource@\$0(?P<number>\??(?:[0-9]|[A-P]+)@)@',
+      name)
+  if not match:
+    return None
+
+  encoded = match.group('number')
+  negative = encoded.startswith('?')
+  if negative:
+    encoded = encoded[1:]
+  encoded = encoded[:-1]
+
+  if encoded == 'A':
+    value = 0
+  elif len(encoded) == 1 and '0' <= encoded <= '9':
+    # MSVC encodes values 1 through 10 as the decimal digits 0 through 9.
+    value = ord(encoded) - ord('0') + 1
+  else:
+    # Larger values are encoded as hexadecimal nibbles A through P.
+    value = 0
+    for digit in encoded:
+      value = (value << 4) | (ord(digit) - ord('A'))
+
+  return -value if negative else value
+
