--- /dev/null
+++ b/tools/dtlto/local_parallel.py
@@ -0,0 +1,46 @@
+# Copyright (c) 2026 The ungoogled-chromium Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Run DTLTO backend jobs concurrently on the local build host."""
+
+import concurrent.futures
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+_MAX_WORKERS = 4
+
+
+def _run_job(common_args, job):
+    subprocess.run(common_args + job["args"], check=True)
+
+
+if __name__ == "__main__":
+    json_path = Path(sys.argv[-1])
+    with json_path.open(encoding="utf-8") as json_file:
+        data = json.load(json_file)
+
+    jobs = data["jobs"]
+    if not jobs:
+        raise SystemExit(0)
+
+    worker_count = min(len(jobs), _MAX_WORKERS)
+    print(
+        f"DTLTO: running {len(jobs)} backend jobs with "
+        f"{worker_count} local workers",
+        flush=True,
+    )
+
+    common_args = data["common"]["args"]
+    with concurrent.futures.ThreadPoolExecutor(
+        max_workers=worker_count
+    ) as executor:
+        futures = [
+            executor.submit(_run_job, common_args, job)
+            for job in jobs
+        ]
+        for future in concurrent.futures.as_completed(futures):
+            future.result()
