+String CleanBlindWatermarks(const String& str) {
+  if (str.empty())
+    return str;
+  StringBuilder sb;
+  sb.ReserveCapacity(str.length());
+  for (unsigned i = 0; i < str.length(); ++i) {
+    UChar c = str[i];
+    if (c == 0x200B || c == 0xFEFF || c == 0x2060)
+      continue;
+    sb.Append(c);
+  }
+  return sb.ToString();
+}
+
+String NormalizeForComparison(const String& str) {
+  if (str.empty())
+    return g_empty_string;
+  StringBuilder sb;
+  sb.ReserveCapacity(str.length());
+  for (unsigned i = 0; i < str.length(); ++i) {
+    UChar c = str[i];
+    if (c == 0x200B || c == 0xFEFF || c == 0x2060)
+      continue;
+    if (c == '\r')
+      continue;
+    if (c == 0x00A0)
+      c = ' ';
+    sb.Append(c);
+  }
+  return sb.ToString().StripWhiteSpace();
+}
+
+bool IsProductivityClipboardData(const DataObject* data_object) {
+  if (!data_object)
+    return false;
+  for (const String& type : data_object->Types()) {
+    if (type.StartsWith("application/x-") || type == "vscode-editor-data") {
+      return true;
+    }
+  }
+  return false;
+}
+
