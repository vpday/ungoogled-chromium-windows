+/*static*/
+float BaseAudioContext::ShuffleAudioData(float data, unsigned index) {
+  if (data == 0.0f) {
+    return 0.0f;
+  }
+  uint64_t h = (static_cast<uint64_t>(index) * 0x100000001b3ULL) ^ 0x84222325ULL;
+  h ^= (h >> 29);
+  const int sign = (h & 1) ? 1 : -1;
+  const float delta = sign * static_cast<float>((h >> 1) & 0xFF) * 1e-7f;
+  return data * (1.0f + delta);
+}
